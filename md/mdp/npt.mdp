integrator            = sd
ld-seed               = -1
dt                    = 0.002
nsteps                = 125000         ; ceil(250 ps / 2 fs)
nstlog                = 100
nstenergy             = 100
nstxout               = 500
pbc                   = xyz
cutoff-scheme          = Verlet
ns-type               = grid
rlist                 = 1.2
rvdw                  = 1.2
rcoulomb              = 1.2
coulombtype           = PME
DispCorr              = EnerPres
vdwtype               = Cut-off
constraints           = h-bonds
constraint-algorithm  = LINCS
tc-grps               = system
tau-t                 = 2.0
ref-t                 = 300.00
pcoupl                = berendsen
tau-p                 = 1.0
ref-p                 = 1.01325
compressibility       = 4.5e-5
