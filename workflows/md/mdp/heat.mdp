integrator            = sd
ld-seed               = -1
dt                    = 0.002
nsteps                = 50000          ; ceil(100 ps / 2 fs)
nstlog                = 100
nstenergy             = 100
nstxout               = 500
pbc                   = xyz
cutoff-scheme          = Verlet
ns-type               = grid
rlist                 = 1.2
rvdw                  = 1.2
rcoulomb              = 1.2
coulombtype           = PME
DispCorr              = EnerPres
vdwtype               = Cut-off
constraints           = h-bonds
constraint-algorithm  = LINCS
tc-grps               = system
tau-t                 = 2.0
ref-t                 = 300.00
annealing             = single
annealing-npoints     = 2
annealing-time        = 0 100
annealing-temp        = 0.00 300.00
